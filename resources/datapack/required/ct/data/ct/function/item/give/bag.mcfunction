execute unless items entity @s ct:whole_inventory minecraft:carrot_on_a_stick[minecraft:custom_model_data={"strings":["ct_bag"]}] run give @s minecraft:carrot_on_a_stick[minecraft:custom_model_data={strings:["ct_bag"]},custom_name=[{text:"Setup Bag",color:"red",italic:false},{text:" [Right-Click]",color:"gray",italic:false}]]
